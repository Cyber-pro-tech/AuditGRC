          <div class="priority-item" style="border-left-color:${domain.color}">
            <div class="p-icon">${domain.icon}</div>
            <div>
              <div class="priority-name">${domain.label}</div>
              <div class="priority-score" style="color:${domain.color}">${score}<span>/100</span></div>
