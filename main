            </div>`;
          }).join('')}
        </div>
      </div>

      <div class="report-section">
        <div class="report-section-tag">03 // PRIORITY ACTION PLAN</div>
        ${recs.slice(0,3).map(({domain,recs:dr})=>`
          <div class="action-domain">
            <div class="action-domain-label" style="color:${domain.color}">${domain.icon} ${domain.label.toUpperCase()}</div>
            ${dr.slice(0,2).map(rec=>`
              <div class="action-row" style="border-left-color:${domain.color}44">
                <span class="action-arrow" style="color:${domain.color}">→</span>
