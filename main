      </div>
    </div>`;

  // ── DOMAINS ──
  document.getElementById('tab-domains').innerHTML = `
    <div style="margin-bottom:28px">
      <div style="color:#dc2626;font-size:10px;letter-spacing:0.35em;margin-bottom:8px">// DOMAIN ANALYSIS</div>
      <div style="color:white;font-size:26px;font-weight:700;letter-spacing:0.02em">Security Domain Breakdown</div>
    </div>
    ${DOMAINS.map(domain => {
      const s = scoreD(domain.id); const m = getMat(s);
      return `<div class="domain-card" style="border-left-color:${domain.color}">
        <div class="domain-card-header">
          <div class="dc-icon">${domain.icon}</div>
          <div class="dc-meta">
            <div class="dc-code">${domain.code} // ${domain.abbr}</div>
            <div class="dc-name">${domain.label}</div>
            <div class="dc-desc">${domain.description}</div>
          </div>
