/* ═══════════════════════════════════════════════
   STATE
════════════════════════════════════════════════ */
let org = {};
let answers = {};
let domainIndex = 0;
let questionIndex = 0;

/* ═══════════════════════════════════════════════
   SCORING
════════════════════════════════════════════════ */
function scoreD(domainId) {
  const d = DOMAINS.find(x => x.id === domainId);
  const vals = d.questions.map(q => answers[q.id] || 0).filter(Boolean);
  if (!vals.length) return 0;
  return Math.round(((vals.reduce((a,b)=>a+b,0)/vals.length) - 1) / 4 * 100);
}
function scoreAll() {
  const s = DOMAINS.map(d => scoreD(d.id)).filter(Boolean);
  return s.length ? Math.round(s.reduce((a,b)=>a+b,0)/s.length) : 0;
}
function getMat(score) {
  return MATURITY.find(m => score >= m.min && score <= m.max) || MATURITY[0];
}
function getRecs() {
  return DOMAINS.map(d => {
    const s = scoreD(d.id);
    const tier = s < 40 ? 'low' : s < 70 ? 'mid' : 'high';
    return { domain:d, score:s, recs:RECS[d.id][tier] };
  }).sort((a,b) => a.score - b.score);
}

/* ═══════════════════════════════════════════════
   CONSTELLATION
════════════════════════════════════════════════ */
(function() {
  const canvas = document.getElementById('constellation');
  const ctx = canvas.getContext('2d');
  let nodes = [], raf;
  function resize() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    nodes = Array.from({length:60}, () => ({
      x:Math.random()*canvas.width, y:Math.random()*canvas.height,
      vx:(Math.random()-0.5)*0.18, vy:(Math.random()-0.5)*0.18,
      r:Math.random()*1.2+0.3,
    }));
  }
  function draw() {
    ctx.clearRect(0,0,canvas.width,canvas.height);
    nodes.forEach(n => {
      n.x+=n.vx; n.y+=n.vy;
      if(n.x<0)n.x=canvas.width; if(n.x>canvas.width)n.x=0;
      if(n.y<0)n.y=canvas.height; if(n.y>canvas.height)n.y=0;
    });
    for(let i=0;i<nodes.length;i++) for(let j=i+1;j<nodes.length;j++){
      const dx=nodes[i].x-nodes[j].x, dy=nodes[i].y-nodes[j].y, d=Math.sqrt(dx*dx+dy*dy);
      if(d<110){
        ctx.beginPath();
        ctx.strokeStyle=`rgba(220,38,38,${(1-d/110)*0.1})`;
        ctx.lineWidth=0.5;
        ctx.moveTo(nodes[i].x,nodes[i].y);
        ctx.lineTo(nodes[j].x,nodes[j].y);
        ctx.stroke();
      }
    }
    nodes.forEach(n=>{
      ctx.beginPath();
      ctx.arc(n.x,n.y,n.r,0,Math.PI*2);
      ctx.fillStyle='rgba(220,38,38,0.4)';
      ctx.fill();
    });
    raf = requestAnimationFrame(draw);
  }
  window.addEventListener('resize', resize);
  resize(); draw();
})();

/* ═══════════════════════════════════════════════
   SVG HELPERS
════════════════════════════════════════════════ */
function makeRing(score, size) {
  const mat = getMat(score);
  const r = (size-20)/2, cx=size/2, cy=size/2;
  const circ = 2*Math.PI*r, dash = (score/100)*circ;
  return `<svg width="${size}" height="${size}" viewBox="0 0 ${size} ${size}">
    <defs><filter id="gl"><feGaussianBlur stdDeviation="3" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter></defs>
    <circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="rgba(255,255,255,0.04)" stroke-width="8"/>
    <circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="${mat.color}" stroke-width="8"
      stroke-dasharray="${dash} ${circ}" stroke-linecap="round"
      transform="rotate(-90 ${cx} ${cy})" filter="url(#gl)"
      style="transition:stroke-dasharray 1.2s cubic-bezier(0.34,1.2,0.64,1)"/>
    <text x="${cx}" y="${cy-10}" text-anchor="middle" fill="white" font-size="${size*0.22}" font-weight="700" font-family="Rajdhani,sans-serif">${score}</text>
    <text x="${cx}" y="${cy+14}" text-anchor="middle" fill="${mat.color}" font-size="${size*0.075}" font-family="Rajdhani,sans-serif" letter-spacing="2">${mat.label.toUpperCase()}</text>
    <text x="${cx}" y="${cy+30}" text-anchor="middle" fill="rgba(255,255,255,0.25)" font-size="${size*0.055}" font-family="Rajdhani,sans-serif">/ 100</text>
  </svg>`;
}

function makeRadar(size) {
  const cx=size/2, cy=size/2, r=size*0.36, n=DOMAINS.length;
  const angle = i => (2*Math.PI*i/n) - Math.PI/2;
  const pt = (i, radius) => ({ x: cx+radius*Math.cos(angle(i)), y: cy+radius*Math.sin(angle(i)) });
  const scores = DOMAINS.map(d => scoreD(d.id)/100);
  const poly = scores.map((s,i) => `${pt(i,r*s).x},${pt(i,r*s).y}`).join(' ');
  const grids = [0.25,0.5,0.75,1].map(l =>
    `<polygon points="${Array.from({length:n},(_,i)=>`${pt(i,r*l).x},${pt(i,r*l).y}`).join(' ')}" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="1"/>`
  ).join('');
  const axes = Array.from({length:n},(_,i) =>
    `<line x1="${cx}" y1="${cy}" x2="${pt(i,r).x}" y2="${pt(i,r).y}" stroke="rgba(255,255,255,0.05)" stroke-width="1"/>`
  ).join('');
  const dots = scores.map((s,i) =>
    `<circle cx="${pt(i,r*s).x}" cy="${pt(i,r*s).y}" r="3.5" fill="${DOMAINS[i].color}"/>`
  ).join('');
  const labels = DOMAINS.map((d,i) => {
    const lp = pt(i, r*1.22);
    return `<text x="${lp.x}" y="${lp.y}" text-anchor="middle" dominant-baseline="middle" fill="${d.color}" font-size="9" font-weight="700" font-family="Rajdhani,sans-serif" letter-spacing="1">${d.abbr}</text>`;
  }).join('');
  return `<svg width="${size}" height="${size}" style="overflow:visible">
    <defs><radialGradient id="rg" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#dc2626" stop-opacity="0.25"/><stop offset="100%" stop-color="#dc2626" stop-opacity="0.04"/></radialGradient></defs>
    ${grids}${axes}
    <polygon points="${poly}" fill="url(#rg)" stroke="#dc2626" stroke-width="1.5"/>
    ${dots}${labels}
  </svg>`;
}

function makeBar(score, color, noAnim) {
  const mat = getMat(score);
  return `<div class="bar-track"><div class="bar-fill" style="width:${noAnim?score:0}%;background:linear-gradient(90deg,${color}66,${color});box-shadow:0 0 6px ${color}88" data-target="${score}"></div></div>`;
}

/* ═══════════════════════════════════════════════
   NAVIGATION
════════════════════════════════════════════════ */
function showScreen(name) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById('screen-'+name).classList.add('active');
  window.scrollTo(0,0);
  if(name==='landing') setTimeout(()=>document.getElementById('hero-inner').classList.add('visible'),80);
  if(name==='assessment') renderAssessment();
  if(name==='results') renderResults();
}

/* ═══════════════════════════════════════════════
   LANDING INIT
════════════════════════════════════════════════ */
(function initLanding() {
  // Domain grid
  const grid = document.getElementById('landing-domain-grid');
  grid.innerHTML = DOMAINS.map(d => `
    <div class="domain-pill" style="border-left:2px solid ${d.color}22">
      <div class="d-icon">${d.icon}</div>
      <div>
        <div class="d-code">${d.code} //</div>
        <div class="d-label">${d.label}</div>
      </div>
    </div>`).join('');
  // Ticker
  const tickers = ['NIST CSF ALIGNED','ISO 27001 VERIFIED','POPIA COMPLIANT','24/7 ELITE SOC','ZERO TRUST ARCHITECTURE','MANAGED XDR READY'];
  document.getElementById('ticker').innerHTML = [...tickers,...tickers].map(t=>`<span>${t}</span>`).join('');
  // Hero reveal
  setTimeout(()=>document.getElementById('hero-inner').classList.add('visible'), 80);
})();

/* ═══════════════════════════════════════════════
   ORG FORM
════════════════════════════════════════════════ */
function submitOrg() {
  const name = document.getElementById('f-name').value.trim();
  const industry = document.getElementById('f-industry').value;
  const size = document.getElementById('f-size').value;
  const role = document.getElementById('f-role').value;
  const err = document.getElementById('org-error');
  if(!name || !industry || !size) { err.style.display='block'; return; }
  err.style.display='none';
  org = { name, industry, size, role };
  answers = {};
  domainIndex = 0;
  questionIndex = 0;
  showScreen('assessment');
}

/* ═══════════════════════════════════════════════
   ASSESSMENT
════════════════════════════════════════════════ */
function renderAssessment() {
  const domain = DOMAINS[domainIndex];
  const q = domain.questions[questionIndex];
  const totalQ = DOMAINS.reduce((a,d)=>a+d.questions.length,0);
  const doneQ = DOMAINS.slice(0,domainIndex).reduce((a,d)=>a+d.questions.length,0) + questionIndex;
  const pct = (doneQ/totalQ)*100;

  // Progress bar
  document.getElementById('progress-fill').style.width = pct+'%';

  // Domain dots
  document.getElementById('domain-dots').innerHTML = DOMAINS.map((d,i) => {
    let cls = 'domain-dot';
    if(i < domainIndex) cls += ' done';
    if(i === domainIndex) cls += ' current';
    return `<div class="${cls}" style="${i===domainIndex?'background:'+d.color+';box-shadow:0 0 6px '+d.color:''}"></div>`;
  }).join('');

  // Sidebar
  const domAnswered = domain.questions.filter(dq => answers[dq.id]).length;
  document.getElementById('sidebar').innerHTML = `
    <div class="sidebar-tag">${domain.code} // DOMAIN ${domainIndex+1}/${DOMAINS.length}</div>
    <div class="sidebar-domain-name" style="color:${domain.color}">${domain.icon} ${domain.label}</div>
    <div class="sidebar-desc">${domain.description}</div>
    <div class="q-progress-label">
      <span style="color:#64748b">DOMAIN PROGRESS</span>
      <span style="color:${domain.color};font-weight:700">${domAnswered}/${domain.questions.length}</span>
    </div>
    <div class="q-progress-track">
      <div class="q-progress-fill" style="width:${domAnswered/domain.questions.length*100}%;background:${domain.color};color:${domain.color}"></div>
    </div>
    <div class="q-nav">
      ${domain.questions.map((dq,i) => {
        const isActive = i===questionIndex;
        const isAnswered = !!answers[dq.id];
        return `<div class="q-nav-item${isActive?' active':''}${isAnswered?' answered':''}"
          style="border-left-color:${isActive?domain.color:isAnswered?'rgba(220,38,38,0.4)':'transparent'}"
          onclick="jumpQ(${i})">
          <div class="q-check" style="border-color:${isAnswered?domain.color:'rgba(255,255,255,0.12)'};background:${isAnswered?domain.color+'22':'transparent'};color:${domain.color}">
            ${isAnswered?'✓':i+1}
          </div>
          <span class="q-num">Q${i+1}</span>
        </div>`;
      }).join('')}
    </div>`;

  // Question area
  const isLast = questionIndex === domain.questions.length-1;
  const isFinalDomain = domainIndex === DOMAINS.length-1;
  document.getElementById('q-area').innerHTML = `
    <div class="q-counter">QUESTION ${questionIndex+1} OF ${domain.questions.length}</div>
    <div class="q-text fade-in">${q.text}</div>
    <div class="options-list fade-in">
      ${q.options.map(opt => {
        const sel = answers[q.id]===opt.s;
        return `<div class="option-item${sel?' selected':''}"
          style="${sel?`border-color:${domain.color};border-left-color:${domain.color}`:''}"
          onclick="selectOpt('${q.id}',${opt.s},'${domain.color}')">
          <div class="option-radio" style="${sel?`border-color:${domain.color};background:${domain.color}`:''}">
            ${sel?'✓':''}
          </div>
          <div>
            <span class="option-level" style="color:${domain.color}">L${opt.s}</span>
            <span class="option-text">${opt.l}</span>
          </div>
        </div>`;
      }).join('')}
    </div>
    <div class="q-footer">
      <button class="btn-nav" onclick="navQ(-1)">← BACK</button>
      <span class="q-answered">${Object.keys(answers).filter(k=>domain.questions.some(dq=>dq.id===k)).length}/${domain.questions.length} ANSWERED</span>
      <button class="btn-next" id="btn-next"
        style="${answers[q.id]?`background:${domain.color};box-shadow:0 0 16px ${domain.color}33`:'background:rgba(255,255,255,0.05)'}"
        onclick="navQ(1)" ${!answers[q.id]?'disabled':''}>
        ${isLast?(isFinalDomain?'GENERATE REPORT →':'NEXT DOMAIN →'):'NEXT →'}
      </button>
    </div>`;
}

function jumpQ(i) { questionIndex = i; renderAssessment(); }

function selectOpt(qId, score, color) {
  answers[qId] = score;
  renderAssessment();
}

function navQ(dir) {
  const domain = DOMAINS[domainIndex];
  if(dir===1) {
    if(questionIndex < domain.questions.length-1) { questionIndex++; renderAssessment(); }
    else if(domainIndex < DOMAINS.length-1) { domainIndex++; questionIndex=0; renderAssessment(); }
    else showScreen('results');
  } else {
    if(questionIndex > 0) { questionIndex--; renderAssessment(); }
    else if(domainIndex > 0) { domainIndex--; questionIndex=DOMAINS[domainIndex].questions.length-1; renderAssessment(); }
    else showScreen('org');
  }
}

/* ═══════════════════════════════════════════════
   RESULTS
════════════════════════════════════════════════ */
function switchTab(name, btn) {
  document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
  document.querySelectorAll('.tab-content').forEach(t=>t.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('tab-'+name).classList.add('active');
  animateBars();
}

function animateBars() {
  setTimeout(()=>{
    document.querySelectorAll('.bar-fill[data-target]').forEach(el=>{
      el.style.width = el.dataset.target+'%';
    });
  }, 100);
}

function renderResults() {
  const overall = scoreAll();
  const mat = getMat(overall);
  const recs = getRecs();
  const date = new Date().toLocaleDateString('en-ZA',{day:'numeric',month:'long',year:'numeric'});

  // ── OVERVIEW ──
  document.getElementById('tab-overview').innerHTML = `
    <div class="result-header">
