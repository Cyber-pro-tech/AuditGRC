        <div style={{padding:24,border:`1px solid ${B.borderRed}`,background:"rgba(220,38,38,0.04)",borderLeft:`3px solid ${B.red}`}}>
          <div style={{display:"flex",alignItems:"center",gap:8,marginBottom:16}}>
            <div style={{width:6,height:6,borderRadius:"50%",background:B.red,boxShadow:`0 0 8px ${B.red}`}}/>
            <span style={{color:B.red,fontSize:10,letterSpacing:"0.3em",fontWeight:700}}>PRIORITY THREAT VECTORS</span>
          </div>
          <div style={{display:"grid",gridTemplateColumns:"repeat(auto-fit,minmax(200px,1fr))",gap:12}}>
            {recs.slice(0,3).map(({domain,score})=>(
              <div key={domain.id} style={{padding:"14px 16px",border:`1px solid rgba(255,255,255,0.05)`,background:"rgba(255,255,255,0.015)",borderLeft:`2px solid ${domain.color}`,display:"flex",gap:10,alignItems:"center"}}>
                <span style={{color:domain.color}}>{domain.icon}</span>
                <div>
                  <div style={{color:"white",fontSize:12,fontWeight:700,letterSpacing:"0.05em"}}>{domain.label}</div>
                  <div style={{color:domain.color,fontSize:20,fontWeight:700,lineHeight:1}}>{score}<span style={{fontSize:9,color:B.muted}}>/100</span></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    )}

    {/* ── DOMAINS ── */}
    {tab==="domains" && (
      <div>
        <div style={{marginBottom:28}}>
          <div style={{color:B.red,fontSize:10,letterSpacing:"0.35em",marginBottom:8}}>// DOMAIN ANALYSIS</div>
          <h2 style={{color:"white",fontSize:26,fontWeight:700,margin:0,letterSpacing:"0.02em"}}>Security Domain Breakdown</h2>
        </div>
        <div style={{display:"flex",flexDirection:"column",gap:16}}>
          {DOMAINS.map(domain=>{
            const s = scoreD(answers,domain.id);
            const m = maturity(s);
            return (
              <div key={domain.id} style={{border:`1px solid ${B.border}`,borderLeft:`3px solid ${domain.color}`,background:B.panel}}>
                <div style={{padding:"20px 24px",borderBottom:`1px solid ${B.border}`,display:"flex",gap:16,alignItems:"center",flexWrap:"wrap"}}>
                  <span style={{color:domain.color,fontSize:22}}>{domain.icon}</span>
                  <div style={{flex:1}}>
                    <div style={{color:B.muted,fontSize:9,letterSpacing:"0.25em",marginBottom:2}}>{domain.code} // {domain.abbr}</div>
                    <div style={{color:"white",fontSize:16,fontWeight:700,letterSpacing:"0.05em"}}>{domain.label}</div>
                    <div style={{color:B.muted,fontSize:11,marginTop:2}}>{domain.description}</div>
                  </div>
                  <div style={{textAlign:"right"}}>
                    <div style={{color:"white",fontSize:36,fontWeight:700,lineHeight:1}}>{s}</div>
                    <div style={{color:m.color,fontSize:9,letterSpacing:"0.2em"}}>{m.label.toUpperCase()}</div>
                    <div style={{width:80,marginTop:6}}><Bar score={s} color={domain.color} label=""/></div>
                  </div>
                </div>
                <div style={{padding:"16px 24px",display:"flex",flexDirection:"column",gap:6}}>
                  {domain.questions.map((dq,qi)=>{
                    const ans = answers[dq.id];
                    const opt = dq.options.find(o=>o.score===ans);
                    return (
                      <div key={dq.id} style={{display:"flex",gap:10,padding:"9px 12px",background:"rgba(255,255,255,0.015)",alignItems:"flex-start"}}>
                        <div style={{width:20,height:20,border:`1px solid ${domain.color}44`,background:`${domain.color}0d`,display:"flex",alignItems:"center",justifyContent:"center",fontSize:8,color:domain.color,fontWeight:700,flexShrink:0,marginTop:1}}>Q{qi+1}</div>
                        <div style={{flex:1}}>
                          <div style={{color:"rgba(255,255,255,0.5)",fontSize:11,marginBottom:3,letterSpacing:"0.03em"}}>{dq.text}</div>
                          {opt&&<div style={{fontSize:11}}><span style={{color:domain.color,fontWeight:700,marginRight:6}}>L{opt.score}</span><span style={{color:"rgba(255,255,255,0.75)"}}>{opt.label}</span></div>}
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    )}

    {/* ── RECOMMENDATIONS ── */}
    {tab==="recommendations" && (
      <div>
        <div style={{marginBottom:28}}>
          <div style={{color:B.red,fontSize:10,letterSpacing:"0.35em",marginBottom:8}}>// REMEDIATION INTELLIGENCE</div>
          <h2 style={{color:"white",fontSize:26,fontWeight:700,margin:0,letterSpacing:"0.02em"}}>Priority Recommendations</h2>
          <p style={{color:B.muted,fontSize:13,marginTop:8,letterSpacing:"0.04em"}}>Ranked by domain score. Recommendations calibrated to your current maturity tier.</p>
        </div>
        <div style={{display:"flex",flexDirection:"column",gap:14}}>
          {recs.map(({domain,score,recs:dr},idx)=>(
            <div key={domain.id} style={{border:`1px solid ${B.border}`,borderLeft:`3px solid ${domain.color}`,background:B.panel}}>
              <div style={{padding:"16px 20px",borderBottom:`1px solid ${B.border}`,display:"flex",alignItems:"center",gap:12,flexWrap:"wrap"}}>
                <span style={{color:domain.color}}>{domain.icon}</span>
                <div style={{flex:1}}>
                  <span style={{color:domain.color,fontSize:9,letterSpacing:"0.2em",marginRight:8}}>{domain.code} //</span>
                  <span style={{color:"white",fontSize:14,fontWeight:700,letterSpacing:"0.05em"}}>{domain.label}</span>
                </div>
                <div style={{display:"flex",gap:10,alignItems:"center"}}>
                  <span style={{color:"white",fontSize:20,fontWeight:700}}>{score}/100</span>
                  <div style={{padding:"3px 10px",border:`1px solid ${idx<2?"rgba(220,38,38,0.4)":idx<4?"rgba(217,119,6,0.4)":"rgba(22,163,74,0.4)"}`,color:idx<2?B.redGlow:idx<4?B.amber:B.green,fontSize:9,letterSpacing:"0.2em",background:idx<2?"rgba(220,38,38,0.07)":idx<4?"rgba(217,119,6,0.07)":"rgba(22,163,74,0.07)"}}>
                    {idx<2?"HIGH RISK":idx<4?"MEDIUM RISK":"LOW RISK"}
                  </div>
                </div>
              </div>
              <div style={{padding:"14px 20px",display:"flex",flexDirection:"column",gap:6}}>
                {dr.map((rec,ri)=>(
                  <div key={ri} style={{display:"flex",gap:10,padding:"10px 12px",background:"rgba(255,255,255,0.015)"}}>
                    <span style={{color:domain.color,fontWeight:700,fontSize:12,flexShrink:0,marginTop:1}}>{ri+1}.</span>
                    <span style={{color:"rgba(255,255,255,0.7)",fontSize:12,lineHeight:1.55,letterSpacing:"0.03em"}}>{rec}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    {/* ── REPORT ── */}
    {tab==="report" && (
      <div>
        <div style={{display:"flex",justifyContent:"space-between",alignItems:"flex-start",flexWrap:"wrap",gap:16,marginBottom:28}}>
          <div>
            <div style={{color:B.red,fontSize:10,letterSpacing:"0.35em",marginBottom:8}}>// ASSESSMENT REPORT</div>
            <h2 style={{color:"white",fontSize:26,fontWeight:700,margin:0,letterSpacing:"0.02em"}}>Executive Security Report</h2>
            <p style={{color:B.muted,fontSize:13,margin:"8px 0 0",letterSpacing:"0.04em"}}>Suitable for board, leadership, or compliance review.</p>
          </div>
        </div>

        <div style={{border:`1px solid ${B.border}`,background:B.panel,padding:36}}>
          {/* Report header */}
          <div style={{borderBottom:`1px solid ${B.border}`,paddingBottom:24,marginBottom:28,display:"flex",justifyContent:"space-between",alignItems:"flex-start",flexWrap:"wrap",gap:16}}>
            <div>
              <div style={{display:"flex",alignItems:"center",gap:8,marginBottom:8}}>
                <div style={{width:24,height:24,border:`1.5px solid ${B.red}`,display:"flex",alignItems:"center",justifyContent:"center",color:B.red,fontSize:8,fontWeight:900}}>CP</div>
                <span style={{color:B.red,fontSize:13,fontWeight:700,letterSpacing:"0.2em"}}>CYBERPRO</span>
                <span style={{color:B.muted,fontSize:9,letterSpacing:"0.2em"}}>// GAUGE ASSESSMENT REPORT</span>
              </div>
              <div style={{color:"white",fontSize:20,fontWeight:700,letterSpacing:"0.04em",marginBottom:2}}>Cybersecurity Posture Report</div>
              <div style={{color:B.muted,fontSize:11,letterSpacing:"0.06em"}}>{org.name} · {org.industry} · {org.size}</div>
            </div>
            <div style={{textAlign:"right"}}>
              <div style={{color:B.muted,fontSize:9,letterSpacing:"0.2em"}}>DATE</div>
              <div style={{color:"white",fontSize:13,fontWeight:700}}>{date}</div>
              <div style={{color:B.muted,fontSize:9,letterSpacing:"0.2em",marginTop:8}}>CLASSIFICATION</div>
              <div style={{color:B.amber,fontSize:11,fontWeight:700,letterSpacing:"0.1em"}}>CONFIDENTIAL</div>
            </div>
          </div>

          {/* Executive summary */}
          <div style={{marginBottom:28}}>
            <div style={{color:B.red,fontSize:9,letterSpacing:"0.3em",marginBottom:12}}>01 // EXECUTIVE SUMMARY</div>
            <div style={{display:"flex",gap:20,flexWrap:"wrap",marginBottom:16}}>
              <div style={{padding:20,border:`1px solid ${mat.color}44`,borderTop:`2px solid ${mat.color}`,background:`${mat.color}08`,minWidth:140}}>
                <div style={{color:B.muted,fontSize:9,letterSpacing:"0.2em",marginBottom:4}}>OVERALL SCORE</div>
                <div style={{color:"white",fontSize:42,fontWeight:700,lineHeight:1}}>{overall}<span style={{fontSize:14,color:B.muted,fontWeight:400}}>/100</span></div>
                <div style={{color:mat.color,fontSize:10,letterSpacing:"0.2em",marginTop:4,fontWeight:700}}>{mat.grade} · {mat.label.toUpperCase()}</div>
              </div>
              <div style={{flex:1,minWidth:200}}>
                <p style={{color:"rgba(255,255,255,0.65)",fontSize:12,lineHeight:1.7,margin:0,letterSpacing:"0.03em"}}>
                  {org.name} completed a CyberPro Gauge cybersecurity posture assessment on {date}. The organisation achieved an overall score of {overall}/100, placing it at the <strong style={{color:mat.color}}>{mat.label}</strong> maturity tier. {mat.desc} The assessment evaluated {DOMAINS.length} security domains across {DOMAINS.reduce((a,d)=>a+d.questions.length,0)} questions, benchmarked against NIST CSF, ISO 27001, and POPIA compliance requirements.
                </p>
              </div>
            </div>
          </div>

          {/* Domain table */}
          <div style={{marginBottom:28}}>
            <div style={{color:B.red,fontSize:9,letterSpacing:"0.3em",marginBottom:12}}>02 // DOMAIN MATURITY MATRIX</div>
            <div style={{border:`1px solid ${B.border}`}}>
              <div style={{display:"grid",gridTemplateColumns:"auto 1fr 80px 80px",gap:0,borderBottom:`1px solid ${B.border}`,padding:"8px 14px",background:"rgba(255,255,255,0.02)"}}>
                {["DOMAIN","","SCORE","MATURITY"].map((h,i)=><div key={i} style={{color:B.muted,fontSize:9,letterSpacing:"0.2em",textAlign:i>1?"center":"left"}}>{h}</div>)}
              </div>
              {DOMAINS.map((d,i)=>{
                const s=scoreD(answers,d.id);const m=maturity(s);
                return (
                  <div key={d.id} style={{display:"grid",gridTemplateColumns:"auto 1fr 80px 80px",gap:0,padding:"10px 14px",borderBottom:i<DOMAINS.length-1?`1px solid ${B.border}`:"none",alignItems:"center"}}>
                    <div style={{display:"flex",alignItems:"center",gap:8,paddingRight:12}}>
                      <span style={{color:d.color}}>{d.icon}</span>
                      <span style={{color:"white",fontSize:11,fontWeight:700,letterSpacing:"0.05em"}}>{d.label}</span>
                    </div>
                    <div style={{paddingRight:16}}><Bar score={s} color={d.color} label=""/></div>
                    <div style={{color:"white",fontSize:16,fontWeight:700,textAlign:"center"}}>{s}</div>
                    <div style={{color:m.color,fontSize:9,letterSpacing:"0.1em",textAlign:"center"}}>{m.label}</div>
                  </div>
                );
              })}
            </div>
          </div>

          {/* Top actions */}
          <div style={{marginBottom:28}}>
            <div style={{color:B.red,fontSize:9,letterSpacing:"0.3em",marginBottom:12}}>03 // PRIORITY ACTION PLAN</div>
            {recs.slice(0,3).map(({domain,recs:dr})=>(
              <div key={domain.id} style={{marginBottom:16}}>
                <div style={{color:domain.color,fontSize:10,fontWeight:700,letterSpacing:"0.15em",marginBottom:6}}>{domain.icon} {domain.label.toUpperCase()}</div>
                {dr.slice(0,2).map((rec,i)=>(
                  <div key={i} style={{display:"flex",gap:8,padding:"8px 12px",marginBottom:4,background:"rgba(255,255,255,0.015)",borderLeft:`2px solid ${domain.color}44`}}>
                    <span style={{color:domain.color,fontWeight:700,flexShrink:0}}>→</span>
                    <span style={{color:"rgba(255,255,255,0.65)",fontSize:11,lineHeight:1.55,letterSpacing:"0.03em"}}>{rec}</span>
                  </div>
                ))}
              </div>
            ))}
          </div>

          {/* Footer */}
          <div style={{borderTop:`1px solid ${B.border}`,paddingTop:16,display:"flex",justifyContent:"space-between",alignItems:"flex-start",flexWrap:"wrap",gap:8}}>
            <div style={{color:B.dim,fontSize:9,lineHeight:1.6,maxWidth:500,letterSpacing:"0.04em"}}>
              This report is generated by CyberPro Gauge and constitutes a baseline self-assessment only. It does not represent a formal cybersecurity audit, penetration test, or certification. Organisations should engage qualified cybersecurity professionals for comprehensive independent assessment. For Managed SOC, Incident Response, or vCISO services, contact CyberPro directly.
            </div>
            <div style={{textAlign:"right"}}>
              <div style={{color:B.red,fontSize:10,fontWeight:700,letterSpacing:"0.2em"}}>CYBERPRO</div>
              <div style={{color:B.dim,fontSize:9}}>cyber-pro.co.za</div>
              <div style={{color:B.dim,fontSize:8,marginTop:4}}>© {new Date().getFullYear()} CyberPro. All rights reserved.</div>
            </div>
          </div>
        </div>
      </div>
    )}
  </div>
</div>
```

);
}

/* ─── APP ────────────────────────────────────────────────────────────────────*/
export default function App() {
useEffect(()=>{
const l=document.createElement(“link”);
l.href=“https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&display=swap”;
l.rel=“stylesheet”; document.head.appendChild(l);
document.body.style.margin=“0”; document.body.style.background=”#050810”;
},[]);

const [screen, setScreen] = useState(“landing”);
const [org, setOrg] = useState(null);
const [dIdx, setDIdx] = useState(0);
const [answers, setAnswers] = useState({});

return (
<>
{screen===“landing” && <Landing onStart={()=>setScreen(“org”)}/>}
{screen===“org” && <OrgScreen onNext={o=>{setOrg(o);setScreen(“assessment”);}}/>}
{screen===“assessment” && (
<AssessmentScreen
domainIndex={dIdx}
answers={answers}
onAnswer={a=>setAnswers(p=>({…p,…a}))}
onNext={()=>{ if(dIdx<DOMAINS.length-1) setDIdx(i=>i+1); else setScreen(“results”); }}
onPrev={()=>{ if(dIdx>0) setDIdx(i=>i-1); else setScreen(“org”); }}
/>
)}
{screen===“results” && <Results org={org} answers={answers}/>}
</>
);
}
