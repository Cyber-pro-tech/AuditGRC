      <div class="card" style="border-top:2px solid ${mat.color}">
        <div class="card-label">OVERALL POSTURE SCORE</div>
        <div class="score-ring-wrap">
          ${makeRing(overall,180)}
          <div class="ring-desc">${mat.desc}</div>
        </div>
      </div>
      <div class="card">
        <div class="card-label">CONSTELLATION OF DEFENCE</div>
        <div class="radar-wrap">${makeRadar(240)}</div>
      </div>
      <div class="card">
        <div class="card-label">DOMAIN INTELLIGENCE</div>
        <div class="domain-bars">
          ${DOMAINS.map(d => {
            const s = scoreD(d.id);
            const m = getMat(s);
            return `<div class="bar-row">
              <div class="bar-labels">
                <span class="bar-label-left">${d.icon} ${d.label}</span>
