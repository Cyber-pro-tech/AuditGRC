    <div style="margin-bottom:28px">
      <div style="color:#dc2626;font-size:10px;letter-spacing:0.35em;margin-bottom:8px">// ASSESSMENT REPORT</div>
      <div style="color:white;font-size:26px;font-weight:700;letter-spacing:0.02em">Executive Security Report</div>
      <div style="color:#64748b;font-size:13px;margin-top:8px">Suitable for board, leadership, or compliance review.</div>
    </div>
    <div class="report-card">
      <div class="report-header">
        <div>
          <div class="report-logo">
            <div class="rb">CP</div>
            <span class="rn">CYBERPRO</span>
