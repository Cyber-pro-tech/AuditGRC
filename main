function AssessmentScreen({domainIndex, answers, onAnswer, onNext, onPrev}) {
const domain = DOMAINS[domainIndex];
const [qIdx, setQIdx] = useState(0);
const [local, setLocal] = useState(answers);
const [vis, setVis] = useState(true);

const q = domain.questions[qIdx];
const progress = (domainIndex / DOMAINS.length) + (qIdx / domain.questions.length / DOMAINS.length);
const domAnswered = domain.questions.filter(dq => local[dq.id]).length;

const nav = (dir) => {
setVis(false);
setTimeout(()=>{
if (dir===1) {
if (qIdx < domain.questions.length-1) setQIdx(i=>i+1);
else { onAnswer(local); onNext(); }
} else {
if (qIdx > 0) setQIdx(i=>i-1);
else { onAnswer(local); onPrev(); }
}
setVis(true);
}, 180);
};

const pick = (id, score) => setLocal(p=>({…p,[id]:score}));

return (
<div style={{minHeight:“100vh”,background:B.bg,fontFamily:”‘Rajdhani’,sans-serif”,display:“flex”,flexDirection:“column”}}>
{/* Top progress */}
<div style={{height:2,background:“rgba(255,255,255,0.04)”}}>
<div style={{height:“100%”,background:B.red,width:`${progress*100}%`,transition:“width 0.4s ease”,boxShadow:`0 0 8px ${B.red}`}}/>
</div>

```
  {/* Nav bar */}
  <div style={{padding:"16px 32px",borderBottom:`1px solid ${B.border}`,display:"flex",alignItems:"center",gap:16}}>
    <div style={{display:"flex",alignItems:"center",gap:8}}>
      <div style={{width:26,height:26,border:`1.5px solid ${B.red}`,display:"flex",alignItems:"center",justifyContent:"center",color:B.red,fontSize:10,fontWeight:900}}>CP</div>
