        </div>
        <div class="report-meta">
          <div class="rm-label">DATE</div>
          <div class="rm-val">${date}</div>
          <div class="rm-label" style="margin-top:8px">CLASSIFICATION</div>
          <div class="rm-conf">CONFIDENTIAL</div>
        </div>
      </div>

      <div class="report-section">
        <div class="report-section-tag">01 // EXECUTIVE SUMMARY</div>
        <div class="exec-row">
          <div class="exec-score-box" style="border-color:${mat.color}44;border-top-color:${mat.color};background:${mat.color}08">
            <div class="es-label">OVERALL SCORE</div>
            <div class="exec-score-big">${overall}<span>/100</span></div>
            <div class="exec-mat-grade" style="color:${mat.color}">${mat.grade} · ${mat.label.toUpperCase()}</div>
          </div>
          <div class="exec-text">
            ${org.name} completed a CyberPro Gauge cybersecurity posture assessment on ${date}.
            The organisation achieved an overall score of ${overall}/100, placing it at the
            <strong style="color:${mat.color}">${mat.label}</strong> maturity tier.
            ${mat.desc}
            The assessment evaluated ${DOMAINS.length} security domains across
            ${DOMAINS.reduce((a,d)=>a+d.questions.length,0)} questions, benchmarked against
            NIST CSF, ISO 27001, and POPIA compliance requirements.
          </div>
        </div>
      </div>

      <div class="report-section">
        <div class="report-section-tag">02 // DOMAIN MATURITY MATRIX</div>
        <div class="domain-table">
          <div class="domain-table-header">
            <span>DOMAIN</span><span></span><span style="text-align:center">SCORE</span><span style="text-align:center">MATURITY</span>
          </div>
          ${DOMAINS.map(d=>{
            const s=scoreD(d.id); const m=getMat(s);
            return `<div class="domain-table-row">
              <div class="dt-name" style="color:white">${d.icon} ${d.label}</div>
              <div>${makeBar(s,d.color,true)}</div>
