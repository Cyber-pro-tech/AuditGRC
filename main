            <div style={{width:16,height:16,border:`1px solid ${local[dq.id]?domain.color:"rgba(255,255,255,0.12)"}`,background:local[dq.id]?`${domain.color}22`:"transparent",display:"flex",alignItems:"center",justifyContent:"center",fontSize:7,color:domain.color,fontWeight:700,flexShrink:0}}>
