          </div>
        </div>
        <div class="domain-card-body">
          ${domain.questions.map((dq,qi)=>{
            const ans = answers[dq.id];
            const opt = dq.options.find(o=>o.s===ans);
            return `<div class="q-row">
              <div class="q-badge" style="border-color:${domain.color}44;background:${domain.color}0d;color:${domain.color}">Q${qi+1}</div>
