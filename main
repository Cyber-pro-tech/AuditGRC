const MATURITY = [
{ min:0,  max:20,  label:“Critical”,   color:”#dc2626”, grade:“F”, desc:“Significant exposure requiring immediate executive intervention.” },
{ min:21, max:40,  label:“Vulnerable”,  color:”#ea580c”, grade:“D”, desc:“Foundational gaps across multiple domains. Urgent remediation needed.” },
{ min:41, max:60,  label:“Developing”,  color:”#d97706”, grade:“C”, desc:“Controls emerging but inconsistently applied. Structured improvement required.” },
{ min:61, max:80,  label:“Managed”,     color:”#2563eb”, grade:“B”, desc:“Structured security posture in place. Optimisation and resilience focus.” },
{ min:81, max:100, label:“Resilient”,   color:”#16a34a”, grade:“A”, desc:“Advanced, adaptive security posture with continuous improvement embedded.” },
];

const RECS = {
governance: {
low:[“Appoint a named individual accountable for cybersecurity at executive level.”,“Draft a cybersecurity policy and obtain board-level sign-off immediately.”,“Initiate a risk register to document and track your top cyber exposures.”],
mid:[“Review and update your cybersecurity policy on at least an annual cycle.”,“Introduce structured board-level cyber reporting with meaningful metrics.”,“Align your programme to a recognised framework — NIST CSF or ISO 27001 recommended.”],
high:[“Pursue ISO 27001 certification or Cyber Essentials Plus to validate your governance posture.”,“Integrate cyber risk into enterprise risk management and board risk appetite.”,“Develop a forward-looking cyber strategy with measurable improvement objectives.”],
},
identity: {
low:[“Enforce MFA on all externally accessible systems as an immediate priority.”,“Audit current accounts — revoke all orphaned or unnecessary access immediately.”,“Define and document role-based access control principles.”],
mid:[“Extend MFA enforcement to all internal systems, not only perimeter access.”,“Establish a formal joiner-mover-leaver process integrated with HR workflows.”,“Deploy centralised identity and directory services to reduce access sprawl.”],
high:[“Evaluate a Privileged Access Management (PAM) solution for administrative accounts.”,“Introduce UEBA or behavioural analytics to detect anomalous access patterns.”,“Advance towards zero trust identity with continuous authentication and device posture.”],
},
technology: {
low:[“Deploy endpoint protection across all managed devices as a baseline control.”,“Establish a patch management schedule — prioritise critical severity patches within 72 hours.”,“Create an IT asset inventory to understand your attack surface.”],
mid:[“Upgrade from antivirus to an EDR solution for improved endpoint visibility.”,“Implement regular vulnerability scanning with structured remediation tracking.”,“Review and tighten network controls; implement basic segmentation between zones.”],
high:[“Adopt continuous vulnerability management with SLA-driven remediation pipelines.”,“Evaluate zero trust network architecture and micro-segmentation strategies.”,“Integrate security testing (DAST/SAST) into software development and procurement.”],
},
data: {
low:[“Identify what personal and sensitive data you hold, where it is stored, and who can access it.”,“Implement full-disk encryption on all laptops and portable devices immediately.”,“Ensure all web-facing services enforce HTTPS/TLS in transit.”],
mid:[“Develop a data classification policy and begin labelling sensitive assets.”,“Review your POPIA compliance obligations and identify material gaps.”,“Test backup restoration procedures — verify recovery is actually possible.”],
high:[“Implement a Data Loss Prevention (DLP) solution to enforce data handling controls.”,“Appoint a Data Protection Officer and establish a formal privacy governance programme.”,“Deploy immutable backup solutions to protect against ransomware-driven data destruction.”],
},
incident: {
low:[“Document a basic incident response plan with clear roles and contact escalation paths.”,“Ensure all staff have a clear, simple mechanism to report a suspected incident.”,“Define what constitutes a reportable incident under POPIA and your regulatory obligations.”],
mid:[“Test your incident response plan through a structured tabletop exercise.”,“Implement centralised log collection to improve detection and investigation capability.”,“Document your BCP with defined RTOs and RPOs for critical business processes.”],
high:[“Conduct adversarial simulations — red team exercises or breach simulation scenarios.”,“Deploy SIEM or engage a Managed SOC for 24/7 threat monitoring and detection.”,“Build post-incident review into your IR process to drive continuous programme improvement.”],
},
thirdparty: {
low:[“Map your critical third-party suppliers and document what access or data they hold.”,“Insert minimum cybersecurity requirements into all new supplier contracts immediately.”,“Require key suppliers to complete a security questionnaire prior to onboarding.”],
mid:[“Tier suppliers by criticality and apply proportionate due diligence at each level.”,“Include right-to-audit and mandatory breach notification clauses in contracts.”,“Integrate supplier incident scenarios into your incident response playbooks.”],
high:[“Implement a formal TPRM programme with automated monitoring and continuous reassessment.”,“Require critical suppliers to hold recognised certifications (ISO 27001, Cyber Essentials).”,“Evaluate fourth-party risk — understand the supply chain risk of your key suppliers’ suppliers.”],
},
};

function scoreD(answers, domainId) {
const domain = DOMAINS.find(d => d.id === domainId);
if (!domain) return 0;
const vals = domain.questions.map(q => answers[q.id] || 0).filter(Boolean);
if (!vals.length) return 0;
return Math.round(((vals.reduce((a,b)=>a+b,0)/vals.length) - 1) / 4 * 100);
}
function scoreAll(answers) {
const s = DOMAINS.map(d => scoreD(answers, d.id));
const f = s.filter(Boolean);
return f.length ? Math.round(f.reduce((a,b)=>a+b,0)/f.length) : 0;
}
function maturity(score) {
return MATURITY.find(m => score >= m.min && score <= m.max) || MATURITY[0];
}
function getRecs(answers) {
return DOMAINS.map(d => {
const s = scoreD(answers, d.id);
const tier = s < 40 ? “low” : s < 70 ? “mid” : “high”;
return { domain: d, score: s, recs: RECS[d.id][tier] };
}).sort((a,b) => a.score - b.score);
}

/* ─── CONSTELLATION BACKGROUND ─────────────────────────────────────────────── */
function Constellation({ style }) {
const canvasRef = useRef(null);
useEffect(() => {
const canvas = canvasRef.current;
if (!canvas) return;
const ctx = canvas.getContext(“2d”);
const W = canvas.width = canvas.offsetWidth;
const H = canvas.height = canvas.offsetHeight;
const nodes = Array.from({length: 60}, () => ({
x: Math.random()*W, y: Math.random()*H,
vx: (Math.random()-0.5)*0.18, vy: (Math.random()-0.5)*0.18,
r: Math.random()*1.2+0.3,
}));
let raf;
function draw() {
ctx.clearRect(0,0,W,H);
nodes.forEach(n => {
n.x += n.vx; n.y += n.vy;
if (n.x < 0) n.x = W; if (n.x > W) n.x = 0;
if (n.y < 0) n.y = H; if (n.y > H) n.y = 0;
});
for (let i=0;i<nodes.length;i++) for (let j=i+1;j<nodes.length;j++) {
const dx=nodes[i].x-nodes[j].x, dy=nodes[i].y-nodes[j].y;
const d=Math.sqrt(dx*dx+dy*dy);
if (d < 110) {
ctx.beginPath();
ctx.strokeStyle = `rgba(220,38,38,${(1-d/110)*0.12})`;
ctx.lineWidth=0.5;
ctx.moveTo(nodes[i].x,nodes[i].y);
ctx.lineTo(nodes[j].x,nodes[j].y);
ctx.stroke();
}
}
nodes.forEach(n => {
ctx.beginPath();
ctx.arc(n.x,n.y,n.r,0,Math.PI*2);
ctx.fillStyle=“rgba(220,38,38,0.45)”;
ctx.fill();
});
raf = requestAnimationFrame(draw);
}
draw();
return () => cancelAnimationFrame(raf);
}, []);
return <canvas ref={canvasRef} style={{position:“absolute”,inset:0,width:“100%”,height:“100%”,…style}} />;
}

/* ─── SCORE RING ─────────────────────────────────────────────────────────────*/
function ScoreRing({score, size=200}) {
const mat = maturity(score);
const r = (size-20)/2;
const cx = size/2, cy = size/2;
const circ = 2*Math.PI*r;
const dash = (score/100)*circ;
return (
<svg width={size} height={size}>
<defs>
<filter id="glow">
<feGaussianBlur stdDeviation="3" result="blur"/>
<feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
</filter>
</defs>
<circle cx={cx} cy={cy} r={r} fill="none" stroke="rgba(255,255,255,0.04)" strokeWidth={8}/>
<circle cx={cx} cy={cy} r={r} fill=“none” stroke={mat.color} strokeWidth={8}
strokeDasharray={`${dash} ${circ}`} strokeLinecap=“round”
transform={`rotate(-90 ${cx} ${cy})`}
filter=“url(#glow)”
style={{transition:“stroke-dasharray 1.2s cubic-bezier(0.34,1.2,0.64,1)”}}/>
<text x={cx} y={cy-10} textAnchor="middle" fill="white" fontSize={size*0.22} fontWeight="700" fontFamily="'Rajdhani',sans-serif">{score}</text>
<text x={cx} y={cy+14} textAnchor="middle" fill={mat.color} fontSize={size*0.075} fontFamily="'Rajdhani',sans-serif" letterSpacing="2">{mat.label.toUpperCase()}</text>
<text x={cx} y={cy+30} textAnchor="middle" fill="rgba(255,255,255,0.25)" fontSize={size*0.055} fontFamily="'Rajdhani',sans-serif">/ 100</text>
</svg>
);
}

/* ─── PROGRESS BAR ───────────────────────────────────────────────────────────*/
function Bar({score, color, label}) {
const [w, setW] = useState(0);
useEffect(()=>{const t=setTimeout(()=>setW(score),120);return()=>clearTimeout(t);},[score]);
const mat = maturity(score);
return (
<div style={{marginBottom:14}}>
<div style={{display:“flex”,justifyContent:“space-between”,marginBottom:5}}>
<span style={{fontSize:11,color:“rgba(255,255,255,0.55)”,fontFamily:”‘Rajdhani’,sans-serif”,letterSpacing:“0.08em”}}>{label}</span>
<div style={{display:“flex”,gap:8,alignItems:“center”}}>
<span style={{fontSize:9,color:mat.color,fontFamily:”‘Rajdhani’,sans-serif”,letterSpacing:“0.12em”}}>{mat.label}</span>
<span style={{fontSize:12,color:“white”,fontWeight:700,fontFamily:”‘Rajdhani’,sans-serif”,minWidth:28,textAlign:“right”}}>{score}</span>
</div>
</div>
<div style={{height:3,background:“rgba(255,255,255,0.05)”,borderRadius:2,overflow:“hidden”,position:“relative”}}>
<div style={{position:“absolute”,top:0,left:0,height:“100%”,width:`${w}%`,background:`linear-gradient(90deg,${color}66,${color})`,borderRadius:2,boxShadow:`0 0 6px ${color}88`,transition:“width 1s cubic-bezier(0.34,1.2,0.64,1)”}}/>
</div>
</div>
);
}

/* ─── RADAR ──────────────────────────────────────────────────────────────────*/
function Radar({answers, size=260}) {
const cx=size/2, cy=size/2, r=size*0.36, n=DOMAINS.length;
const angle = i => (2*Math.PI*i/n) - Math.PI/2;
const pt = (i, radius) => ({ x: cx+radius*Math.cos(angle(i)), y: cy+radius*Math.sin(angle(i)) });
const scores = DOMAINS.map(d => scoreD(answers,d.id)/100);
const poly = scores.map((s,i)=>`${pt(i,r*s).x},${pt(i,r*s).y}`).join(” “);
return (
<svg width={size} height={size} style={{overflow:“visible”}}>
<defs>
<radialGradient id="radarG" cx="50%" cy="50%" r="50%">
<stop offset="0%" stopColor="#dc2626" stopOpacity="0.25"/>
<stop offset="100%" stopColor="#dc2626" stopOpacity="0.04"/>
</radialGradient>
</defs>
{[0.25,0.5,0.75,1].map((l,i)=>(
<polygon key={i} points={Array.from({length:n},(*,j)=>`${pt(j,r*l).x},${pt(j,r*l).y}`).join(” “)}
fill=“none” stroke=“rgba(255,255,255,0.05)” strokeWidth={1}/>
))}
{Array.from({length:n},(*,i)=>(
<line key={i} x1={cx} y1={cy} x2={pt(i,r).x} y2={pt(i,r).y} stroke="rgba(255,255,255,0.05)" strokeWidth={1}/>
))}
<polygon points={poly} fill="url(#radarG)" stroke={B.red} strokeWidth={1.5}/>
{scores.map((s,i)=>(
<circle key={i} cx={pt(i,r*s).x} cy={pt(i,r*s).y} r={3.5} fill={DOMAINS[i].color}/>
))}
{DOMAINS.map((d,i)=>{
const lp = pt(i, r*1.22);
return <text key={i} x={lp.x} y={lp.y} textAnchor="middle" dominantBaseline="middle"
fill={d.color} fontSize={9} fontWeight="700" fontFamily="'Rajdhani',sans-serif" letterSpacing="1">{d.abbr}</text>;
})}
</svg>
);
}

